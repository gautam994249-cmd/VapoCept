    "index.html": {
      "settings": {
        "main": true,
        "title": "VapoCept  – Natural Male Vitality & Performance Boost",
        "meta_descr": "Misplaced keys. A name that won't come to you. A conversation you have to ask someone to repeat. If moments like these have been showing up more often, you're not alone — and VapoCept was formulated with exactly this kind of everyday mental fog in mind.",
        "header_custom": "<meta name=\"keywords\" content=\"prosta defend, prostadefend, prosta defend supplement, prosta defend pills\">\n <meta name=\"author\" content=\"prosta defend\">\n\t\t\n <link rel=\"canonical\" href=\"\" >",
